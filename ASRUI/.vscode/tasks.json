{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend Server",
            "type": "shell",
            "command": "cd backend && uv run python main.py",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Frontend Server",
            "type": "shell",
            "command": "cd frontend && PORT=3003 BROWSER=none npm start",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Both Servers",
            "dependsOrder": "parallel",
            "dependsOn": ["Start Backend Server", "Start Frontend Server"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}